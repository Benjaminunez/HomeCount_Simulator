        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\n\nclass User {\n  + username: String\n  + password: String\n  + email: String\n  + is_superuser: Boolean\n}\n\nclass Admin {\n  + password: String\n}\n\nAdmin --|&gt; User \n\nclass Avatar {\n  + imagen: ImageField\n}\n\nclass CodigoRecuperacion {\n  + codigo: String\n  + creado_en: DateTimeField\n}\n\nclass Proyecto3D {\n  + nombre: String\n  + costo_total: DecimalField\n  + datos_escena: JSONField\n  + datos_camara: JSONField\n  + imagen_captura: ImageField\n  + area_cuadrada: DecimalField\n  + fecha_creacion: DateTimeField\n  + fecha_modificacion: DateTimeField\n}\n\nclass CasaPrefabricada {\n  + nombre: String\n  + descripcion: TextField\n  + costo_total: IntegerField\n  + datos_escena: JSONField\n  + datos_camara: JSONField\n  + imagen_captura: ImageField\n  + area_cuadrada: DecimalField\n  + fecha_creacion: DateTimeField\n  + fecha_modificacion: DateTimeField\n}\n\nclass ModeloCasa {\n  + nombre: String\n  + metros_cuadrados: IntegerField\n  + habitaciones: IntegerField\n  + banos: IntegerField\n  + descripcion: TextField\n  + precio: BigIntegerField\n  + imagen: ImageField\n  + precio_formateado(): String\n}\n\nUser \&quot;1\&quot; -- \&quot;1\&quot; Avatar : avatar_usuario\nUser \&quot;1\&quot; -- \&quot;*\&quot; CodigoRecuperacion : solicita\nUser \&quot;1\&quot; -- \&quot;*\&quot; Proyecto3D : crea y guarda\nAdmin \&quot;1\&quot; -- \&quot;*\&quot; CasaPrefabricada : gestiona\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VbkCq7ZQUdYprjHE-cnD-1">
